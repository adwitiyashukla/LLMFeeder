# Footnote reads LLM credentials from local sources only: this file, then the shell
# environment. Nothing is ever sent to any Footnote service. Copy this file to `.env`
# and fill in whichever provider you use. `.env` is gitignored.
#
# The lexical judge needs none of this and is the default.

# --- OpenAI and any OpenAI-compatible endpoint (Groq, Together, OpenRouter, Ollama) ---
# OPENAI_API_KEY=sk-...
# FOOTNOTE_MODEL=gpt-4o-mini
# FOOTNOTE_BASE_URL=https://api.openai.com/v1

# --- Anthropic ---
# ANTHROPIC_API_KEY=sk-ant-...
# FOOTNOTE_MODEL=claude-haiku-4-5-20251001

# --- Local Ollama (no key needed, set the base URL and a dummy key) ---
# OPENAI_API_KEY=ollama
# FOOTNOTE_BASE_URL=http://localhost:11434/v1
# FOOTNOTE_MODEL=llama3.1
